{
  "$schema": "https://opencode.ai/config.json",
  // Job-fetching loop Playwright MCP (merged with the repo-root config, whose
  // guardrails subagent_depth/permission.task stay inherited).
  //
  // PURPOSE: visually drive the SAME persistent Chrome profiles the scrapers
  // use (Indeed/Glassdoor run headed with .runtime/<source>-profile). When a
  // CAPTCHA blocks a scrape you can open these tools to inspect the live page,
  // confirm/refresh selectors against a real snapshot, or solve the challenge
  // like a human before the loop re-runs. --storage-state reuses the saved
  // session so no re-login / re-solve is needed after the first success.
  //
  // USAGE inside a beat: use the browser via the MCP tools (browser_navigate /
  // browser_snapshot / browser_click) with "--user-data-dir" below so it shares
  // the scraper's profile — solving the CAPTCHA here clears it for the loop too.
  "mcp": {
    "playwright-jobs": {
      "type": "local",
      "command": [
        "npx", "-y", "@playwright/mcp@latest",
        "--browser", "chrome",
        "--user-data-dir", "/home/muhammadtayyab/panaversity_learning/loop_engineering_with_general_agents/job_fetching_loop/.runtime/probe-profile",
        "--viewport-size", "1440,900"
      ],
      "enabled": true
    },
    "playwright-linkedin": {
      "type": "local",
      "command": [
        "npx", "-y", "@playwright/mcp@latest",
        "--browser", "chrome",
        "--user-data-dir", "/home/muhammadtayyab/panaversity_learning/loop_engineering_with_general_agents/job_fetching_loop/.runtime/linkedin-profile",
        "--viewport-size", "1440,900"
      ],
      "enabled": true
    }
  }
}