# === Scraping ===
# Primary AI-domain keywords: a job MUST match at least one to qualify.
SCRAPE_KEYWORDS=AI,Machine Learning,LLM,NLP,Data Science,Computer Vision,AI FDE
# Secondary role keywords (scraper targeting only — never qualify alone).
SCRAPE_ROLE_KEYWORDS=Engineer,Developer
SCRAPE_DELAY_MIN=1.0
SCRAPE_DELAY_MAX=3.0
SCRAPE_HEADLESS=1
# 1 = keep STRICTLY remote jobs; drop on-site AND hybrid AND unknown-location.
SCRAPE_REMOTE_ONLY=1
SCRAPE_TZ=Asia/Karachi

# Anti-bot sources (Indeed/Glassdoor) run HEADED with a persistent Chrome
# profile (.runtime/<source>-profile). When CAPTCHA appears, solve it once in
# the visible browser window — the session is reused on every later run.
CAPTCHA_SOLVE_TIMEOUT=300

# === Sources (enable/disable) ===
SOURCE_REMOTE_ROCKETSHIP=1
SOURCE_WORKING_NOMADS=1
SOURCE_LINKEDIN=0
SOURCE_INDEED=1
SOURCE_GLASSDOOR=0
SOURCE_APAC_REMOTE=1
SOURCE_PAKISTAN_REMOTE=1
# Scrape LinkedIn hiring FEED POSTS ("we're hiring" status updates) in addition
# to the jobs board. Friday is the spec'd "LinkedIn feed 'we are hiring' day"
# and adds extra hiring-scene phrasing to the feed search. Kill-switch for
# feed-markup drift without disabling the whole LinkedIn source.
SOURCE_LINKEDIN_FEED=1

# Curated remote job boards — JSON-API sources (enabled by default).
SOURCE_REMOTIVE=1
SOURCE_HIMALAYAS=1

# wellfound + justremote are LIVE (implemented + live-verified 2026-09-15).
SOURCE_WELLFOUND=1
SOURCE_JUSTREMOTE=1

# Curated boards — collectors not wired yet (live-verify selectors first).
# These are registered but default-OFF via DEFAULT_DISABLED_SOURCES in config;
# flip SOURCE_<NAME>=1 only after the parser is implemented and live-verified.
SOURCE_FEEDCOYOTE=0
SOURCE_JOBBOARDSEARCH=0
SOURCE_FLEXJOBS=0
SOURCE_DYNAMITEJOBS=0
SOURCE_VIRTUAL_VOCATIONS=0
SOURCE_NODESK=0

# === Notifications ===
NOTIFY_TELEGRAM=1
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_WHATSAPP=0
WHATSAPP_ACCOUNT_SID=
WHATSAPP_AUTH_TOKEN=
WHATSAPP_FROM=
WHATSAPP_TO=
# Post the weekly digest as a public LinkedIn status update (weekly-only, Monday
# delivery after the 3-day backfill). Requires: LinkedIn Developer app ->
# OAuth2 token scoped `w_member_social` (60-day lifetime) + the author's person
# URN (urn:li:person:<id>). Fail-closed when either is missing.
NOTIFY_LINKEDIN=0
LINKEDIN_POST_ACCESS_TOKEN=
LINKEDIN_POST_URN=

# === Limits ===
MAX_JOBS_PER_SOURCE=100
DEDUP_WINDOW_DAYS=30
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_RESET_HOURS=1
# How long a run waits for the state lock before exiting (seconds).
# If two crons race, the loser exits cleanly instead of corrupting shared state.
LOCK_TIMEOUT_S=5