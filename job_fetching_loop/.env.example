# === Runner (pick ONE primary to avoid duplicate Telegram) ===
# local  = this machine's cron / run_loop.sh is primary (default in code)
# github = GitHub Actions cron is primary; local run_loop.sh no-ops
# both   = both fire (duplicate notifications)
JOB_LOOP_PRIMARY=github
JOB_LOOP_ENABLED=1
# Set automatically by .github/workflows/job-loop-cron.yml — do not set locally.
# JOB_LOOP_CLOUD=1
# CLOUD_ALLOW_BROWSER=0

# === Scraping ===
# Primary AI-domain keywords: a job MUST match at least one to qualify.
SCRAPE_KEYWORDS=AI,Machine Learning,LLM,NLP,Data Science,Computer Vision,AI FDE,Generative AI,GenAI,Deep Learning,MLOps,AI Agent,PyTorch
# Secondary role keywords (scraper targeting only — never qualify alone).
SCRAPE_ROLE_KEYWORDS=Engineer,Developer
SCRAPE_DELAY_MIN=1.0
SCRAPE_DELAY_MAX=3.0
SCRAPE_HEADLESS=1
# 1 = keep STRICTLY remote jobs; drop on-site AND hybrid AND unknown-location.
SCRAPE_REMOTE_ONLY=1
SCRAPE_TZ=Asia/Karachi

# Anti-bot sources (Indeed/Glassdoor) run HEADED with a persistent Chrome
# profile (.runtime/<source>-profile). Cloud cron skips these unless
# CLOUD_ALLOW_BROWSER=1. When CAPTCHA appears locally, solve it once in the
# visible browser window — the session is reused on later local runs.
CAPTCHA_SOLVE_TIMEOUT=300

# === Sources (enable/disable) ===
SOURCE_REMOTE_ROCKETSHIP=1
SOURCE_WORKING_NOMADS=1
SOURCE_LINKEDIN=1
SOURCE_INDEED=1
SOURCE_GLASSDOOR=0
SOURCE_APAC_REMOTE=1
SOURCE_PAKISTAN_REMOTE=1
# Scrape LinkedIn hiring FEED POSTS ("we're hiring" status updates). Needs
# --linkedin-login once on a local machine. Cloud guest search still runs.
SOURCE_LINKEDIN_FEED=1

# Curated remote job boards — JSON/RSS sources (cloud-safe).
SOURCE_REMOTIVE=1
SOURCE_HIMALAYAS=1
SOURCE_REMOTEOK=1
SOURCE_WEWORKREMOTELY=1
SOURCE_JOBICY=1
SOURCE_NODESK=1

# wellfound + justremote are LIVE. justremote is Playwright (local-only on cloud).
SOURCE_WELLFOUND=1
SOURCE_JUSTREMOTE=1

# Curated boards — collectors not wired yet (live-verify selectors first).
SOURCE_FEEDCOYOTE=0
SOURCE_JOBBOARDSEARCH=0
SOURCE_FLEXJOBS=0
SOURCE_DYNAMITEJOBS=0
SOURCE_VIRTUAL_VOCATIONS=0

# === Notifications ===
NOTIFY_TELEGRAM=1
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_WHATSAPP=0
WHATSAPP_ACCOUNT_SID=
WHATSAPP_AUTH_TOKEN=
WHATSAPP_FROM=
WHATSAPP_TO=
NOTIFY_LINKEDIN=0
LINKEDIN_POST_ACCESS_TOKEN=
LINKEDIN_POST_URN=

# Optional BD Google Apps Script webhook (append-only).
GOOGLE_SHEET_WEBHOOK_URL=

# === Limits ===
MAX_JOBS_PER_SOURCE=250
DEDUP_WINDOW_DAYS=30
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_RESET_HOURS=1
LOCK_TIMEOUT_S=5
# Hard per-source wall-clock cap (a hung Playwright source fails instead of
# stalling the whole loop). LinkedIn's authenticated browser pass has its own
# tighter cap below.
SOURCE_TIMEOUT_S=150
LINKEDIN_GUEST_TIMEOUT_S=45
LINKEDIN_BROWSER_TIMEOUT_S=90
