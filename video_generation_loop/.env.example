# Video Generation Loop Configuration
# 100% Browser-Based Automation (Uses your Google PRO plan — NO API KEY NEEDED).

# Storyboard planner. Default = 'template' (offline, deterministic, no API, no
# browser). 'gemini' = Gemini API (needs GEMINI_API_KEY). 'gemini-web' = browser
# on gemini.google.com (needs a signed-in Flow profile). Start with template.
FLOW_PLANNER=template

# Money-gate override: Flow PRO normally shows an "Approve N credits" dialog
# before each generation. If your account auto-approves and the dialog never
# appears, set this to 1 to skip the mandatory first-approval gate.
# Default = 0 (fail-closed: the day aborts until it sees an explicit approval).
# FLOW_CREDITS_PREAPPROVED=0

# Google Flow (Veo 3.1)
FLOW_URL=https://labs.google/fx/tools/flow
FLOW_HEADLESS=1            # set 0 to watch the browser while it works
FLOW_PROFILE_DIR=.runtime/flow-profile

# Unattended runs (cron/CI): a blocking step FAILS loudly and logs to
# manual_todo.txt instead of waiting at the screen. `1` forces fail-fast;
# it is also implied by headless mode or a non-TTY (no human) stdin.
FLOW_AUTO_FAILFAST=1

# Extend mode (single-download build): grow ONE scene in Flow's scene editor
# with the Extend feature (storyboard scene prompts become 'What happens
# next?' continuations) and download ONE final.mp4 — no per-clip downloads,
# no ffmpeg concat. Default = 0 (legacy per-scene clips + concat).
# FLOW_EXTEND_MODE=1
# Target length for the extend-built video (8..96 seconds; Veo clips are 8s,
# so 60 lands on 64s). The chain always lands on the smallest clip multiple
# >= this target, and the final evaluator gates on THAT multiple ±5s.
# FLOW_TARGET_DURATION_S=60

# Cross-process lock deadline for the state/upload files (seconds). Raise if a
# manual run and the cron ever collide. Bad values fail with a one-liner.
# FLOW_LOCK_TIMEOUT=5

# YouTube Private Scheduled Upload
YOUTUBE_CLIENT_SECRETS=.runtime/client_secret.json
YOUTUBE_TOKEN_FILE=.runtime/youtube_token.json
YOUTUBE_PUBLISH_TIME=18:00
YOUTUBE_PUBLISH_TZ=Asia/Karachi