# GitHub MCP Server Configuration
# Rename this file to .env and add your personal access token

# GitHub Personal Access Token (PAT) - required for authentication
# Create one at: https://github.com/settings/personal-access-tokens/new
# Recommended scopes: repo, read:user, read:repo_hook, workflow, admin:repo_hook
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_YOUR_TOKEN_HERE 

# MCP Server Toolsets - enable maximum available tools
# Use "all" for all available toolsets, or specify comma-separated list
# Available toolsets: context, issues, pull_requests, repos, users, actions, code_quality, code_security, copilot, etc.
GITHUB_TOOLSETS=all

# Optional: Read-only mode (set to "false" to enable write operations)
GITHUB_READ_ONLY=false

# Optional: Server name/title (visible in MCP tool listings)
GITHUB_MCP_SERVER_NAME=loop-engineering-mcp

# Optional: Insiders mode (early access to new features)
GITHUB_INSIDERS=false